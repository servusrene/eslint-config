{
  "name": "@servusrene/eslint-config",
  "version": "1.0.0",
  "description": "Shareable ESLint flat config (JavaScript, TypeScript, React)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/servusrene/eslint-config.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recommended": {
      "types": "./dist/configs/recommended.d.ts",
      "default": "./dist/configs/recommended.js"
    },
    "./typescript": {
      "types": "./dist/configs/typescript.d.ts",
      "default": "./dist/configs/typescript.js"
    },
    "./react": {
      "types": "./dist/configs/react.d.ts",
      "default": "./dist/configs/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "npm run build && eslint .",
    "lint:fix": "npm run build && eslint . --fix",
    "test": "npm run build && node --test 'test/*.test.js'"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "servusrene"
}
